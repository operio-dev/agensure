  if (loader) loader.remove();
}

function goToStep(n) {
  if (n === 2) {
    const model = document.querySelector('select[name="base_model"]').value;
    const scope = document.querySelector('select[name="agent_scope"]').value;
    if (!model || !scope) {
      alert('Please select both Base Model and Operational Scope before continuing.');
      return;
    }
  }
  if (n === 3) {
    const prompt = document.querySelector('textarea[name="system_prompt"]').value.trim();
    if (prompt.length < 20) {
      alert('Please paste at least a short excerpt of your System Prompt before continuing.');
      return;
    }
  }
  document.querySelectorAll('.flash-step').forEach(s => s.style.display = 'none');
  document.getElementById('step-' + n).style.display = 'block';
  ['dot-0','dot-1','dot-2'].forEach((id, i) => {
    document.getElementById(id).style.background = i < n ? '#3b82f6' : 'rgba(59,130,246,0.2)';
  });
}

document.getElementById('flash-test-overlay').addEventListener('click', function(e) {
  if (e.target === this) closeFlashTest();
});

document.getElementById('flash-test-form').addEventListener('submit', function(e) {
  e.preventDefault();
  const email = this.querySelector('input[name="email"]').value;
  const blocked = ['gmail.com','yahoo.com','hotmail.com','outlook.com','icloud.com','protonmail.com','live.com'];
  const domain = email.split('@')[1]?.toLowerCase();
  if (blocked.includes(domain)) {
    const emailInput = this.querySelector('input[name="email"]');
    emailInput.style.borderColor = '#f43f5e';
    let msg = document.getElementById('email-error');
    if (!msg) {
      msg = document.createElement('p');
      msg.id = 'email-error';
      msg.style.cssText = 'font-size:11px;color:#f43f5e;margin-top:4px;';
      emailInput.parentNode.appendChild(msg);
    }
    msg.textContent = 'Personal email addresses are not accepted. Please use your work email.';
    return;
  }
  const err = document.getElementById('email-error');
  if (err) err.remove();
  const btn = this.querySelector('button[type=submit]');
  btn.textContent = 'Sending...';
  btn.disabled = true;
  fetch('https://formspree.io/f/xlgvpzqw', {
    method: 'POST',
    body: new FormData(this),
    headers: { 'Accept': 'application/json' }
  }).then(r => {
    if (r.ok) {
      document.getElementById('flash-success').style.display = 'block';
      btn.style.display = 'none';
    } else {
      btn.textContent = '⚡ Execute Flash Test →';
      btn.disabled = false;
    }
  }).catch(() => {
    btn.textContent = '⚡ Execute Flash Test →';
    btn.disabled = false;
  });
});
function contactUs(e) {
  if(e) e.preventDefault();
  document.getElementById('contact-overlay').style.display = 'flex';
  document.body.style.overflow = 'hidden';
}
function closeContact() {
  document.getElementById('contact-overlay').style.display = 'none';
  document.body.style.overflow = '';
}
document.getElementById('contact-overlay').addEventListener('click', function(e) {
