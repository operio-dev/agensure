  function toggleFaq(btn) {
    const item = btn.parentElement;
    const answer = item.querySelector('.faq-answer');
    const isOpen = item.classList.contains('open');
    document.querySelectorAll('.faq-item.open').forEach(el => { el.classList.remove('open'); el.querySelector('.faq-answer').style.maxHeight = '0'; });
    if (!isOpen) { item.classList.add('open'); answer.style.maxHeight = answer.scrollHeight + 'px'; }
  }

  // stat counter removed — new problem section uses cards

  const TABS_DURATION = 5000;
  const tabs = document.querySelectorAll('.product-tab');
  const panels = document.querySelectorAll('.product-visual-panel');
  let currentTab = 0, fillInterval = null, fillStart = null;

function activateTab(idx) {
    tabs.forEach((t, i) => { 
      t.classList.toggle('active', i === idx); 
      t.querySelector('.tab-progress-fill').style.height = '0%'; 
    });
    panels.forEach((p, i) => p.classList.toggle('active', i === idx));
    currentTab = idx;
  }
function startFill(idx) {
    clearInterval(fillInterval);
    const fill = tabs[idx].querySelector('.tab-progress-fill');
    fill.style.height = '0%';
    fillStart = performance.now();
    fillInterval = setInterval(() => {
      const pct = Math.min(((performance.now() - fillStart) / TABS_DURATION) * 100, 100);
      fill.style.height = pct + '%';
      if (pct >= 100) { clearInterval(fillInterval); const next = (currentTab + 1) % tabs.length; activateTab(next); startFill(next); }
    }, 16);
  }
  tabs.forEach((tab, i) => tab.addEventListener('click', () => { activateTab(i); startFill(i); }));
  const productObserver = new IntersectionObserver((entries) => {
    if (entries[0].isIntersecting) { startFill(0); productObserver.disconnect(); }
  }, { threshold: 0.3 });
  if (document.querySelector('.product')) productObserver.observe(document.querySelector('.product'));

  document.querySelectorAll('.product-visual-panel img').forEach(img => {
    img.addEventListener('click', () => {
      const overlay = document.createElement('div');
      overlay.style.cssText = 'position:fixed;inset:0;background:rgba(0,0,0,0.85);z-index:9999;display:flex;align-items:center;justify-content:center;cursor:zoom-out;';
      const big = document.createElement('img');
      big.src = img.src;
      big.style.cssText = 'max-width:90vw;max-height:90vh;border-radius:10px;';
      overlay.appendChild(big);
      overlay.addEventListener('click', () => overlay.remove());
      document.body.appendChild(overlay);
    });
  });
</script>

